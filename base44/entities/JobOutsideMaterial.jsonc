{
  "name": "JobOutsideMaterial",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "Reference to Job"
    },
    "vendor": {
      "type": "string",
      "description": "Vendor name where material was picked up"
    },
    "material": {
      "type": "string",
      "description": "Material name/description"
    },
    "quantity": {
      "type": "number",
      "description": "Quantity of material"
    },
    "quantity_definition": {
      "type": "string",
      "description": "Unit of measurement (e.g., yards, tons, sq ft)"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "job_id",
    "vendor",
    "material",
    "quantity",
    "quantity_definition"
  ]
}